# Local Docker / LAN development. Use a random URL-safe password and HTTPS for deployment.
PORT=5738
BIND_ADDRESS=0.0.0.0
POSTGRES_PASSWORD=astra-local-development
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
WORKSPACE_VOLUME=astracode-workspaces
ENGINE_INSTANCE=local
# Terminals run on their own bridge: internet yes, database and API no.
SANDBOX_NETWORK=astracode-sandbox
# Used only when Docker has no free address pool left for a new network.
SANDBOX_SUBNET=10.201.7.0/24
